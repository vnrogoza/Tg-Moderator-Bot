{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐍 Python: Server + Web Panel (Port 3000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "args": ["--port", "3000"]
    },
    {
      "name": "🤖 Python: Standalone Telegram Bot (bot.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "⚡ Node: npm run dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ]
}
